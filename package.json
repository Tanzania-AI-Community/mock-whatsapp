{
  "name": "mock-whatsapp",
  "version": "0.1",
  "private": true,
  "type": "module",
  "author": "Fredy German Mgimba",
  "scripts": {
    "clean": "rimraf --glob **/node_modules **/dist **/.next pnpm-lock.yaml **/.tsbuildinfo",
    "build": "next build && if [ -d public ]; then cp -r public .next/standalone/; fi && cp -r .next/static .next/standalone/.next/",
    "dev": "next dev -H 127.0.0.1",
    "observe": "APP_MODE=observe next dev -H 127.0.0.1",
    "start": "cd .next/standalone && node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.test.json --test \"lib/*.test.ts\" \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "shadcn:add": "pnpm dlx shadcn@latest add"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.8.2",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "drizzle-kit": "^0.31.11"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "engines": {
    "node": ">=22.13.0"
  }
}
